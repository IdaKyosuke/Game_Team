  jobText:
  - jobName: "\u6226\u58EB"
    firstPassive: "\u3059\u3079\u3066\u306E\u30B9\u30C6\u30FC\u30BF\u30B9\u304C\u5C11\u3057\u3060\u3051\u4E0A\u6607\u3059\u308B"
    secondPassive: "\u6B7B\u306B\u81F3\u308B\u653B\u6483\u3092\u4E00\u5EA6\u3060\u3051\u4F53\u529B1\u3067\u8010\u3048\u308B"
    thirdPassive: "\u76F8\u624B\u306E\u653B\u6483\u3067\u53D7\u3051\u308B\u30C0\u30E1\u30FC\u30B8\u3092\u30AB\u30C3\u30C8\u3059\u308B"
    jobType: 0
  - jobName: "\u9B54\u6CD5\u4F7F\u3044"
    firstPassive: "\u653B\u6483\u3092\u3057\u305F\u969B\u306B\u72B6\u614B\u7570\u5E38(\u3084\u3051\u3069)\u3092\u3064\u3051\u308B\u3053\u3068\u304C\u3042\u308B"
    secondPassive: "\u653B\u6483\u3092\u3057\u305F\u969B\u306B\u72B6\u614B\u7570\u5E38(\u51CD\u50B7)\u3092\u3064\u3051\u308B\u3053\u3068\u304C\u3042\u308B"
    thirdPassive: "\u653B\u6483\u3092\u3057\u305F\u969B\u306B\u72B6\u614B\u7570\u5E38(\u611F\u96FB)\u3092\u3064\u3051\u308B\u3053\u3068\u304C\u3042\u308B"
    jobType: 1
  - jobName: "\u50E7\u4FB6"
    firstPassive: "\u5F98\u5F8A\u3059\u308B\u30E2\u30F3\u30B9\u30BF\u30FC\u306B\u4E0E\u3048\u308B\u30C0\u30E1\u30FC\u30B8\u304C\u4E0A\u6607\u3059\u308B"
    secondPassive: "\u4F53\u529B\u304C\u4E00\u5B9A\u6642\u9593\u3067\u81EA\u52D5\u56DE\u5FA9\u3059\u308B"
    thirdPassive: "\u30B2\u30FC\u30E0\u958B\u59CB\u6642\u306B\u4E00\u5B9A\u91CF\u306E\u30C0\u30E1\u30FC\u30B8\u304B\u3089\u8EAB\u3092\u5B88\u308B\u30D0\u30EA\u30A2\u3092\u5F35\u308B"
    jobType: 2
  - jobName: "\u76D7\u8CCA"
    firstPassive: "\u5B9D\u7BB1\u3092\u958B\u5C01\u3059\u308B\u307E\u3067\u306E\u6642\u9593\u304C\u77ED\u304F\u306A\u308B"
    secondPassive: "\u79FB\u52D5\u901F\u5EA6\u304C\u5C11\u3057\u3060\u3051\u4E0A\u6607\u3059\u308B"
    thirdPassive: "Legendary\u306E\u5B9D\u7BB1\u3092\u958B\u3051\u308B\u30AB\u30AE\u3092\u4E00\u3064\u6240\u6301\u3059\u308B"
